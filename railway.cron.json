{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "echo 'cron service: no build step, jobs run from source through tsx'"
  },
  "deploy": {
    "startCommand": "pnpm jobs nightly",
    "cronSchedule": "0 9 * * *",
    "restartPolicyType": "NEVER"
  }
}
