# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# On Railway these are set as service variables, not from a file.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# ADMIN_DATABASE_URL owns the tables and runs migrations. On Railway this is
# the connection string Postgres hands you (user `postgres`).
#
# DATABASE_URL is what the application uses at runtime. It MUST point at the
# unprivileged `app_user` role created by `pnpm db:setup-roles`, NOT at
# `postgres`. A superuser bypasses Row Level Security entirely, which would
# silently disable Layer 1 of the access enforcement. The app refuses to boot
# if it detects it is connected as a superuser or as the table owner.
ADMIN_DATABASE_URL="postgresql://postgres:PASSWORD@HOST:PORT/railway"
DATABASE_URL="postgresql://app_user:APP_PASSWORD@HOST:PORT/railway"

# Password assigned to the app_user role by scripts/setup-roles.ts.
APP_DB_PASSWORD="generate-a-long-random-string"

# --- Field encryption -----------------------------------------------------
# Provider: "local" uses lib/security/kms/local.ts, an AES-256-GCM stand-in for
# KMS that wraps per-company DEKs with a master key held in this env var.
# Switch to "aws" and set AWS_KMS_CMK_ID for production. Call sites do not change.
KMS_PROVIDER="local"

# Only used when KMS_PROVIDER=local. 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCAL_KMS_MASTER_KEY=""

# Only used when KMS_PROVIDER=aws.
AWS_REGION="us-east-1"
AWS_KMS_CMK_ID=""

# --- Object storage -------------------------------------------------------
# "local" writes to ./.local-storage and serves signed URLs from the app.
# "s3" uses a private bucket with SSE-KMS. Call sites do not change.
STORAGE_PROVIDER="local"
S3_BUCKET=""
S3_REGION="us-east-1"

# --- SMS ------------------------------------------------------------------
# "console" prints the message and the invite link to the server log.
SMS_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Email ----------------------------------------------------------------
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="noreply@example.com"

# --- App ------------------------------------------------------------------
# Public origin, used to build invite links. No trailing slash.
APP_URL="http://localhost:3000"

# Secret for signing invite tokens and sessions. 32+ bytes.
AUTH_SECRET=""

NODE_ENV="development"

# Set to "true" only once the e-signature documents in lib/esign/documents.ts
# have been replaced with copy approved by counsel in English and translated to
# Spanish by a person. The application refuses to start in production without it.
ESIGN_TEXTS_APPROVED="false"

# Shown in the authenticator app when a staff member enrols.
APP_NAME="Onboarding"
