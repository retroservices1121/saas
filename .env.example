# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# On Railway these are set as service variables, not from a file.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# ADMIN_DATABASE_URL owns the tables and runs migrations. On Railway this is
# the connection string Postgres hands you (user `postgres`).
#
# DATABASE_URL is what the application uses at runtime. It MUST point at the
# unprivileged `app_user` role created by `pnpm db:setup-roles`, NOT at
# `postgres`. A superuser bypasses Row Level Security entirely, which would
# silently disable Layer 1 of the access enforcement. The app refuses to boot
# if it detects it is connected as a superuser or as the table owner.
ADMIN_DATABASE_URL="postgresql://postgres:PASSWORD@HOST:PORT/railway"
DATABASE_URL="postgresql://app_user:APP_PASSWORD@HOST:PORT/railway"

# Password assigned to the app_user role by scripts/setup-roles.ts.
APP_DB_PASSWORD="generate-a-long-random-string"

# --- Field encryption -----------------------------------------------------
# "local"  a master key in this file. Fine for development. In production it
#          means anyone holding this variable holds every tenant's data, with
#          nothing recording that they used it.
# "vault"  HashiCorp Vault Transit. Key material stays in Vault, every unwrap is
#          logged, and access is revoked by changing a policy rather than by
#          redeploying.
# "aws"    AWS KMS (not implemented — the interface is there, the calls are not).
#
# Call sites do not change between them.
KMS_PROVIDER="local"

# Only used when KMS_PROVIDER=local. 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCAL_KMS_MASTER_KEY=""

# Only used when KMS_PROVIDER=vault. Set the key up once with:
#   vault secrets enable transit
#   vault write -f transit/keys/onboarding derived=true
#
# derived=true makes Vault compute a distinct wrapping key per company, so a
# wrapped DEK lifted from one company's row cannot be unwrapped as another's
# even by a caller holding a valid token.
VAULT_ADDR=""
VAULT_TOKEN=""
VAULT_TRANSIT_KEY="onboarding"
VAULT_TRANSIT_MOUNT="transit"
VAULT_TRANSIT_DERIVED="true"
# HCP Vault Dedicated puts every mount under a namespace. Vault OSS does not.
VAULT_NAMESPACE=""

# Only used when KMS_PROVIDER=aws.
AWS_REGION="us-east-1"
AWS_KMS_CMK_ID=""

# --- Object storage -------------------------------------------------------
# "local" writes to ./.local-storage.
# "s3"    any S3-compatible bucket: Railway Buckets, Cloudflare R2, MinIO, AWS.
#
# Every object is encrypted with the owning company's data key BEFORE it is
# uploaded, so the provider holds ciphertext and no key. That is what replaces
# the spec's SSE-KMS, and it is why the choice of provider is not a security
# decision.
#
# On Railway, attaching a Bucket to the service provides BUCKET, ACCESS_KEY_ID,
# SECRET_ACCESS_KEY, ENDPOINT and REGION automatically — leave the S3_* names
# blank and they will be picked up. The S3_* names win if both are set.
STORAGE_PROVIDER="local"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_REGION="auto"

# --- SMS ------------------------------------------------------------------
# "console" prints the message and the invite link to the server log.
SMS_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Email ----------------------------------------------------------------
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="noreply@example.com"

# --- App ------------------------------------------------------------------
# Public origin, used to build invite links. No trailing slash.
APP_URL="http://localhost:3000"

# Secret for signing invite tokens and sessions. 32+ bytes.
AUTH_SECRET=""

NODE_ENV="development"

# Set to "true" only once the e-signature documents in lib/esign/documents.ts
# have been replaced with copy approved by counsel in English and translated to
# Spanish by a person. The application refuses to start in production without it.
ESIGN_TEXTS_APPROVED="false"

# Shown in the authenticator app when a staff member enrols.
APP_NAME="Onboarding"
