{
  "name": "onboarding-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:setup-roles": "tsx scripts/setup-roles.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:bootstrap": "pnpm db:migrate && pnpm db:setup-roles",
    "test": "vitest run",
    "test:isolation": "vitest run tests/isolation",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "drizzle-orm": "^0.38.4",
    "next": "15.1.6",
    "next-intl": "^3.26.3",
    "postgres": "^3.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.1.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
